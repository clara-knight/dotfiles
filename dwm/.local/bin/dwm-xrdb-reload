#!/bin/sh
# dwm-xrdb-reload — regenerate hellwal/colors.json from ~/.Xresources,
# merge into the X server, and refresh pywal terminal sequences.
# Called from dwm's Mod+F5 (xrdb()) and safe to run manually.
#
# Data flow:  .Xresources  →  colors.json + colors_tty.json  →  wal --theme
#
# colors_tty.json applies the TTY swap: color0 ← background, color8 ← original color0.

set -u

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
PKG_XRES="$DOTFILES/dwm/.Xresources"
XRES="$HOME/.Xresources"
COLORS_JSON="$DOTFILES/hellwal/colors.json"
COLORS_TTY_JSON="$DOTFILES/hellwal/colors_tty.json"

# Prefer the stow source; fall back to $HOME copy
SRC_XRES="$PKG_XRES"
if [ ! -f "$SRC_XRES" ]; then
    SRC_XRES="$XRES"
fi

# 1. Parse .Xresources and write colors.json + colors_tty.json
if [ -f "$SRC_XRES" ] && command -v python3 >/dev/null 2>&1; then
    python3 - "$SRC_XRES" "$COLORS_JSON" "$COLORS_TTY_JSON" 2>/dev/null <<'PYEOF'
import json, re, sys

xres_path = sys.argv[1]
colors_path = sys.argv[2]
colors_tty_path = sys.argv[3]

# Parse Xresources: we want *.colorN, *.background, *.foreground, *.cursor
colors = {}
special = {}
with open(xres_path) as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith('!'):
            continue
        m = re.match(r'\*\.\s*(color\d+|background|foreground|cursor)\s*:\s*(#[0-9a-fA-F]{6})', line)
        if m:
            key, val = m.group(1), m.group(2)
            if key in ('background', 'foreground', 'cursor'):
                special[key] = val
            else:
                colors[key] = val

bg = special.get('background', '#000000')
fg = special.get('foreground', '#ffffff')
cur = special.get('cursor', fg)

# Build standard colors.json
data = {
    "special": {"background": bg, "foreground": fg, "cursor": cur},
    "colors": {("color%d" % i): colors.get("color%d" % i, "#000000") for i in range(16)}
}
with open(colors_path, 'w') as f:
    json.dump(data, f, indent=4)
    f.write('\n')

# Build colors_tty.json with TTY swap: color0 ← background, color8 ← original color0
tty_colors = dict(data["colors"])
orig_color0 = tty_colors.get("color0", "#000000")
tty_colors["color0"] = bg
tty_colors["color8"] = orig_color0

tty_data = {
    "special": {"background": bg, "foreground": fg, "cursor": cur},
    "colors": tty_colors
}
with open(colors_tty_path, 'w') as f:
    json.dump(tty_data, f, indent=4)
    f.write('\n')
PYEOF
fi

# 2. Refresh wal cache from the freshly generated colors.json
if [ -f "$COLORS_JSON" ] && command -v wal >/dev/null 2>&1; then
    wal --theme "$COLORS_JSON" -q 2>/dev/null || wal -R 2>/dev/null || true
fi

# 3. Merge .Xresources into the X server
if [ -f "$XRES" ] && command -v xrdb >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    xrdb -merge "$XRES" 2>/dev/null || true
fi
