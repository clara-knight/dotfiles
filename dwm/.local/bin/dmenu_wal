#!/bin/sh
# dmenu wrapper using active Pywal theme colors
# nb = normal background	nf = normal foreground (text)
# sb = selected item bg		sf = selected item fg

if [ -f "$HOME/.cache/wal/colors.sh" ]; then
    . "$HOME/.cache/wal/colors.sh"
    exec dmenu_run -fn "Noto Mono:size=10" -nb "$color0" -nf "$color7" -sb "$color10" -sf "$color5" "$@"
else
    exec dmenu_run -fn "Noto Mono:size=10" "$@"
fi
