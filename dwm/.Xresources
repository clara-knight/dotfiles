! dwm/.Xresources — source of truth for all colors.
! Run dwm-xrdb-reload (or Mod+F5) to regenerate hellwal/colors.json,
! apply Wal sequences, and merge into the X server.
! Stowed to ~/.Xresources.

*.background:	#000000
*.foreground:	#ffffff
*.cursor:	#fcd4ef
dwm.background:	#33393c
dwm.text:	#e2e3e4
dwm.foreground:	#ffffff
dwm.cursor:	#fcd4ef

*.color0:	#7c8a91
*.color1:	#b30164
*.color2:	#ff9747
*.color3:	#e359a2
*.color4:	#ffa82e
*.color5:	#c34f92
*.color6:	#e82a2a
*.color7:	#fff0ed
*.color8:	#7c8a92
*.color9:	#b35287
*.color10:	#ffb882
*.color11:	#e38fbc
*.color12:	#ffc16b
*.color13:	#c27aa4
*.color14:	#e86666
*.color15:	#fff0ed


! Extra dwm-only colors (color16–color23).
! These are NOT exported to Wal/colors.json — dwm reads them directly via xrdb.
*.color16:	#7c7d7d
*.color17:	#000000
