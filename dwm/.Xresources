! dwm/.Xresources — generated from hellwal/colors.json
! Do not hand-edit colors here; re-run dwm-xrdb-reload (or dwm-xrdb-generate)
! to regenerate from ~/dotfiles/hellwal/colors.json. Stowed to ~/.Xresources.
! Keeps st as-is, wal still drives terminal/nvim/dmenu; dwm reads dwm.* keys.
! (with *. fallbacks) via loadxrdb().

*.background:	#0d0c0b
*.foreground:	#ffffff
*.cursor:	#fcd4ef
dwm.background:	#0d0c0b
dwm.foreground:	#ffffff
dwm.cursor:	#fcd4ef

*.color0:	#7c8a91
